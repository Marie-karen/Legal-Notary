    "seed": "node scripts/importer-referentiel.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.12.0",
    "web-push": "^3.6.7"
  }
}
