{
  "name": "legal-notary-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Legal Notary — gestion d'office notarial (Côte d'Ivoire). API Express + PostgreSQL, auto-hébergeable.",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node scripts/importer-referentiel.js",
    "test": "NODE_ENV=test node --test tests/*.test.js",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "lint:pr": "node ../scripts/securite/verifier-eslint-pr.js",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "securite:fichiers": "node ../scripts/securite/verifier-fichiers-interdits.js",
    "securite:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.12.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "prettier": "^3.9.9"
  }
}
