# .env.example — Modèle de configuration Legal Notary (Section 3 bis & S04).
# Le fichier .env ne doit JAMAIS être versionné dans Git (droits 600 requis : chmod 600 .env).
#
# Pour générer automatiquement un fichier .env complet et sécurisé :
#   npm run generer-cles
#   (ou : node scripts/generer-cles-installation.js)
#
# Pour la procédure détaillée de changement et rotation de clés :
#   Consultez docs/CONFIGURATION.md

# -----------------------------------------------------------------------------
# 1. Base de données PostgreSQL locale dédiée au cabinet (Mac mini ou dédié)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://legalnotary:motdepasse@localhost:5432/legalnotary
PORT=4000
NODE_ENV=production

# -----------------------------------------------------------------------------
# 2. Clés secrètes cryptographiques OBLIGATOIRES (Section 3 bis — Exigence n°4)
# Règle stricte S04 : exactement 64 caractères hexadécimaux (32 octets aléatoires).
# Aucune valeur de secours en dur ; aucune retombée ni réutilisation autorisée.
# Le serveur refuse catégoriquement de démarrer si une seule clé manque ou est invalide.
# -----------------------------------------------------------------------------

# Signature et vérification des jetons d'authentification des collaborateurs
JWT_SECRET=generer_avec_npm_run_generer_cles_exactement_64_hex_caracteres

# Chiffrement AES-256-GCM des sauvegardes et archives WORM
BACKUP_ENCRYPTION_KEY=generer_avec_npm_run_generer_cles_exactement_64_hex_caracteres

# Anciennes clés de sauvegarde conservées en lecture seule pour la restauration (séparées par des virgules)
# BACKUP_ENCRYPTION_KEYS_ARCHIVE=ancienne_cle_1_64hex,ancienne_cle_2_64hex

# Chiffrement AES-256-GCM au repos des identifiants tiers (mots de passe SMTP, tokens SMS/WhatsApp)
CLE_CHIFFREMENT_NOTIFS=generer_avec_npm_run_generer_cles_exactement_64_hex_caracteres

# Clé secrète partagée pour l'authentification de l'API interne et du webhook sortant
CONTROL_HUB_SECRET_KEY=generer_avec_npm_run_generer_cles_exactement_64_hex_caracteres

# -----------------------------------------------------------------------------
# 3. Paramètres de session et web
# -----------------------------------------------------------------------------
JWT_EXPIRATION=12h
# ORIGINE_FRONTEND=https://etude-notaire.ci

# -----------------------------------------------------------------------------
# 4. SaaS de Contrôle Centralisé (Master Admin Hub)
# -----------------------------------------------------------------------------
CONTROL_HUB_WEBHOOK_URL=https://control-hub.votredomaine.com/api/webhooks/notary

# -----------------------------------------------------------------------------
# 5. Passerelle SMTP pour les notifications et déploiements
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.votrefournisseur.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@legalnotary.app
SMTP_PASS=mot-de-passe-ou-cle-api-smtp
SMTP_FROM_NAME="Legal Notary — Direction des Déploiements"
SMTP_FROM_EMAIL=notifications@legalnotary.app
