# .env.example — copier en ".env" et renseigner les vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (voir .gitignore) : il
# contient des secrets propres à l'installation de ce cabinet.

# Connexion à la base PostgreSQL de ce cabinet (serveur physique ou cloud,
# propre à chaque installation — voir docs/DEPLOIEMENT.md).
DATABASE_URL=postgres://legalnotary:motdepasse@localhost:5432/legalnotary

# Port d'écoute de l'API.
PORT=4000

# 1. Secret de signature des jetons de connexion (JWT).
# À générer une seule fois par installation avec : openssl rand -hex 32
# Ne JAMAIS réutiliser la même valeur entre deux cabinets.
JWT_SECRET=generer-une-cle-secrete-aleatoire-32-octets-avec-openssl-rand-hex-32

# 2. Clé de chiffrement au repos AES-256-GCM pour les sauvegardes WORM et archives.
# À générer avec : openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=generer-une-cle-aes256-aleatoire-avec-openssl-rand-hex-32

# 3. Clé de chiffrement AES-256 pour les identifiants SMTP / VAPID stockés.
CLE_CHIFFREMENT_NOTIFS=generer-une-cle-notifs-aleatoire-avec-openssl-rand-hex-32

# Durée de validité d'une session de connexion.
JWT_EXPIRATION=12h

# Dossier du frontend statique (legal-notary-web/) à servir depuis ce même
# serveur — voir docs/DEPLOIEMENT.md. Par défaut, le dossier voisin
# legal-notary-web/ (même disposition qu'en développement) ; à changer
# seulement si ce cabinet range ses dossiers autrement.
# FRONTEND_DIR=/chemin/vers/legal-notary-web

# Origine exacte du frontend, seulement utile si le frontend est servi
# séparément de cette API (pas le cas par défaut — voir ci-dessus). Sans
# cette variable, l'API accepte les requêtes de n'importe quelle origine.
# ORIGINE_FRONTEND=https://etude-exemple.ci

# SaaS de Contrôle Centralisé (Master Super Admin Hub)
# Clé partagée secrète pour authentifier les requêtes du Master Admin
CONTROL_HUB_SECRET_KEY=generer-une-cle-secrete-hub-aleatoire-avec-openssl-rand-hex-32
# URL du Webhook de notification sortante vers le Master Admin
CONTROL_HUB_WEBHOOK_URL=https://control-hub.votredomaine.com/api/webhooks/notary

